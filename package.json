{
    "name": "taller-conecta",
    "version": "0.2.0",
    "private": true,
    "description": "Plataforma que conecta talleres mecánicos con sus clientes: seguimiento, presupuestos y autorizaciones.",
    "engines": {
        "node": ">=20.9.0"
    },
    "scripts": {
        "dev": "node scripts/ensure-env.mjs && next dev --webpack",
        "build": "next build --webpack",
        "cf-build": "opennextjs-cloudflare build",
        "start": "next start",
        "deploy": "opennextjs-cloudflare build && npx wrangler deploy",
        "test": "vitest run",
        "typecheck": "tsc --noEmit",
        "e2e": "playwright test",
        "lint": "eslint lib/database/drizzle.ts lib/auth/rate-limit-kv.ts lib/orders/plan-limits.ts app/api/media drizzle vitest.config.ts eslint.config.mjs playwright.config.ts middleware.ts app/o app/app components/portal app/seguimiento/[token]/page.tsx tests/state-machine.test.ts tests/validations.test.ts tests/workflows.test.ts tests/e2e --max-warnings 0",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "@opennextjs/cloudflare": "^1.20.16",
        "cloudflare": "^7.3.0",
        "jose": "5.9.6",
        "lucide-react": "^0.454.0",
        "mailtrap": "^6.0.0",
        "next": "16.4.5",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "wrangler": "^4.154.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@playwright/test": "^1.64.1",
        "@tailwindcss/postcss": "^4.3.3",
        "@types/node": "^22.0.0",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "drizzle-kit": "^0.31.11",
        "drizzle-orm": "^0.45.4",
        "eslint": "^9.39.5",
        "eslint-config-next": "^15.5.29",
        "globals": "^15.15.0",
        "postcss": "8.5.30",
        "prettier": "^3.9.10",
        "selfsigned": "^5.5.0",
        "tailwindcss": "^4.3.3",
        "tsx": "4.23.15",
        "typescript": "5.6.3",
        "vite": "^6.4.0",
        "vitest": "^5.1.0"
    },
    "allowScripts": {
        "esbuild@0.28.2": true
    },
    "overrides": {
        "glob": "14.0.3",
        "minimatch": "11.0.1",
        "@node-minify/core": {
            "glob": "14.0.3",
            "minimatch": "11.0.1"
        },
        "esbuild": "0.25.12"
    }
}
